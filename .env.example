# Railway production required
NODE_ENV=production
PORT=
HOST=0.0.0.0
APP_BASE_URL=https://your-domain.example
DB_PATH=/data/ai-studio.sqlite
UPLOAD_DIR=/data/uploads

# Local development
# NODE_ENV=development
# PORT=3000
# HOST=127.0.0.1
# APP_BASE_URL=http://localhost:3000
# DB_PATH=./data/ai-studio.sqlite
# UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
MAX_MODEL_UPLOAD_BYTES=104857600
MAX_PROXY_IMAGE_BYTES=10485760

# Database maintenance. Only use while Railway is still test data.
AI_STUDIO_ALLOW_DB_RESET=false
AI_STUDIO_DB_RESET_ON_BOOT=false

# AI providers
DASHSCOPE_API_KEY=
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_EDIT_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis
DASHSCOPE_TASK_URL=https://dashscope.aliyuncs.com/api/v1/tasks
VOLCENGINE_API_KEY=
VOLCENGINE_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
TRIPO_API_KEY=
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_DEFAULT_MODEL=v3.1-20260211
ENABLE_APIMART=true
ENABLE_APIMART_IMAGE=true
ENABLE_APIMART_VIDEO=true
ENABLE_APIMART_QWEN=true
ENABLE_APIMART_DOUBAO=true
ENABLE_APIMART_NANO=true
ENABLE_APIMART_GPT_IMAGE=true
ENABLE_APIMART_MJ=true
ENABLE_APIMART_SEEDANCE=true
ENABLE_APIMART_KLING=true
SHOW_OFFICIAL_MODELS=false
SHOW_APIMART_BRAND=false

# Authentication providers
AUTH_CODE_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=AI Studio
ALIYUN_DM_REPLY_TO_ADDRESS=false

WECHAT_OAUTH_CLIENT_ID=
WECHAT_OAUTH_CLIENT_SECRET=
WECHAT_OAUTH_REDIRECT_URI=

QQ_OAUTH_CLIENT_ID=
QQ_OAUTH_CLIENT_SECRET=
QQ_OAUTH_REDIRECT_URI=

# Local/test mocks. Never enable these in production.
APIMART_MOCK=false
# AUTH_CODE_PROVIDER=mock
