PORT=3000
NODE_ENV=development

# Required for AI generation features. Keep the real key only in local or deployment secrets.
DASHSCOPE_API_KEY=

# Optional. Defaults to ./data/ai-studio.sqlite when unset.
SQLITE_DB_PATH=

# Optional. Defaults to ./uploads when unset.
UPLOAD_DIR=

# Optional safety limits.
MAX_UPLOAD_BYTES=26214400
MAX_PROXY_IMAGE_BYTES=10485760

# Optional provider overrides.
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_EDIT_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis
DASHSCOPE_TASK_URL=https://dashscope.aliyuncs.com/api/v1/tasks
