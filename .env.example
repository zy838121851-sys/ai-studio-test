PORT=3000
NODE_ENV=development

# Required for AI generation features. Keep the real key only in local or deployment secrets.
DASHSCOPE_API_KEY=

# Optional. Defaults to ./data/ai-studio.sqlite when unset.
SQLITE_DB_PATH=

# Optional. Defaults to ./uploads when unset.
UPLOAD_DIR=

# Optional safety limits.
MAX_UPLOAD_BYTES=26214400
MAX_PROXY_IMAGE_BYTES=10485760

# Auth providers. Use "aliyun" in production. Use "mock" only for local development/tests.
AUTH_CODE_PROVIDER=aliyun
APP_BASE_URL=http://localhost:3000

# Aliyun SMS + Direct Mail verification code providers.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=AI Studio
ALIYUN_DM_REPLY_TO_ADDRESS=false

# WeChat Open Platform website app OAuth config.
WECHAT_OAUTH_CLIENT_ID=
WECHAT_OAUTH_CLIENT_SECRET=
WECHAT_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/wechat/callback

# QQ Connect website app OAuth config.
QQ_OAUTH_CLIENT_ID=
QQ_OAUTH_CLIENT_SECRET=
QQ_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/qq/callback

# Optional provider overrides.
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_EDIT_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis
DASHSCOPE_TASK_URL=https://dashscope.aliyuncs.com/api/v1/tasks
